# Hermes Discord Gateway environment variables
# Copy/merge these into ~/.hermes/.env and fill in real values.
# NEVER commit real tokens.

# Required: Bot token from Discord Developer Portal → Application → Bot → Token
DISCORD_BOT_TOKEN=

# Required unless using allowed roles/channels/allow-all.
# Comma-separated Discord user IDs allowed to interact with Hermes.
DISCORD_ALLOWED_USERS=

# Optional: comma-separated Discord role IDs authorized to use the bot.
# DISCORD_ALLOWED_ROLES=

# Recommended safety defaults
DISCORD_REQUIRE_MENTION=true
DISCORD_IGNORE_NO_MENTION=true
DISCORD_ALLOW_BOTS=none
DISCORD_REACTIONS=true

# Optional: channels where Hermes responds without an @mention.
# Use this for a dedicated private #hermes channel.
# DISCORD_FREE_RESPONSE_CHANNELS=

# Optional: channels where Hermes never responds.
# DISCORD_IGNORED_CHANNELS=

# Optional: proactive output/home channel for cron, reminders, notifications.
# DISCORD_HOME_CHANNEL=
# DISCORD_HOME_CHANNEL_NAME=#hermes

# Mention safety. Leave everyone/roles disabled unless you deliberately need them.
DISCORD_ALLOW_MENTION_EVERYONE=false
DISCORD_ALLOW_MENTION_ROLES=false
DISCORD_ALLOW_MENTION_USERS=true
DISCORD_ALLOW_MENTION_REPLIED_USER=true

# Attachment limit. Default is 32 MiB.
DISCORD_MAX_ATTACHMENT_BYTES=33554432
